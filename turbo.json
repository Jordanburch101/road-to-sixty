{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "tasks": {
    "test": { "env": ["LUA51"] },
    "@road-to-sixty/server#test": { "cache": false, "env": ["LUA51"] },
    "check": {},
    "typecheck": {},
    "package": { "cache": false, "outputs": ["build/**", "dist/**"] },
    "build": { "outputs": ["dist/**"] },
    "@road-to-sixty/desktop#test": { "dependsOn": ["build"] },
    "@road-to-sixty/desktop#check": { "dependsOn": ["build"] }
  }
}
