---
import Layout from "../../layouts/Layout.astro";
import { addonUrl } from "../../config";
---
<Layout title="Download · Road to Sixty">
  <main class="mx-auto flex max-w-xl flex-col items-center gap-6 px-4 py-24 text-center">
    <h1 class="text-4xl font-medium tracking-tight">Download Road to Sixty</h1>
    <p class="text-muted">The app runs on a Mac or a Windows PC.</p>
    <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
      <a href="/download/mac" class="inline-flex h-11 items-center justify-center rounded-[10px] bg-cream px-[18px] text-[15px] font-medium text-ink">For Mac</a>
      <a href="/download/windows" class="inline-flex h-11 items-center justify-center rounded-[10px] bg-cream px-[18px] text-[15px] font-medium text-ink">For Windows</a>
    </div>
    <p class="text-sm text-muted">Just want the addon? <a href={addonUrl()} class="text-text underline underline-offset-2">It works on its own</a>.</p>
  </main>
</Layout>
