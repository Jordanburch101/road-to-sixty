---
// Privacy and Terms: one readable column, as in the Site-Privacy mockup.
import Layout from "./Layout.astro";

const { title, changed } = Astro.props as { title: string; changed: string };
---
<Layout title={`${title} · Road to Sixty`}>
  <main data-reveal class="prose-rts mx-auto max-w-[640px] px-4 pb-24 pt-[72px]">
    <h1 class="text-[40px] font-medium tracking-[-0.03em]">{title}</h1>
    <div class="mt-2.5 text-sm text-muted">Last changed {changed}</div>
    <slot />
  </main>
</Layout>
