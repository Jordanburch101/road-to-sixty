---
import compass from "@road-to-sixty/ui/compass.png";
---
<footer class="mt-28 flex flex-col gap-3.5 border-t border-line-soft px-4 pb-10 pt-8 text-[13px] text-faint md:px-16">
  <div class="flex flex-wrap items-center gap-2.5">
    <img src={compass.src} alt="" width="20" height="20" class="size-5 rounded-[5px]" />
    <span class="flex-1 text-muted">Road to Sixty, made by <a href="https://jordanburch.dev" class="text-[#c9c4d6] hover:text-text">Jordan Burch</a></span>
    <a href="/privacy" class="px-2.5 py-1.5 text-muted hover:text-text">Privacy</a>
    <a href="/terms" class="px-2.5 py-1.5 text-muted hover:text-text">Terms</a>
  </div>
  <p>Not affiliated with or endorsed by Blizzard Entertainment. World of Warcraft is a trademark of Blizzard Entertainment, Inc.</p>
</footer>
