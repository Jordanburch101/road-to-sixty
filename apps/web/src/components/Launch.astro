---
// Before launch: the beta and a countdown. After: launch-day text. Both are
// in the page and countdown.ts swaps them when launch passes; a build made
// after launch starts on the launch-day text, so nothing flashes.
import { addonUrl } from "../config";
import { LAUNCH } from "../countdown";
import DownloadButton from "./DownloadButton.astro";

const launched = Date.now() >= LAUNCH;
const groups = ["Days", "Hours", "Minutes", "Seconds"];
---
<section data-reveal class="mt-28 flex w-full max-w-[1040px] flex-col items-center gap-4 px-4 text-center md:mt-[150px]">
  <div data-before-launch data-reveal hidden={launched} class="contents">
    <h2 class="text-3xl font-medium leading-[1.1] tracking-[-0.03em] md:text-[40px]">Try it on the beta.</h2>
    {/* The script fills the tiles; the sentence under the board says the same for screen readers. */}
    <div data-countdown aria-hidden="true" class="board mt-4 flex gap-3 md:gap-5">
      {groups.map((label) => (
        <div class="flex flex-col items-center gap-2.5">
          <div class="flex gap-1">
            {[0, 1].map(() => (
              <span data-tile class="tile">
                <span class="half top"><span data-half></span></span>
                <span class="half bottom"><span data-half></span></span>
                <span class="half top fold"><span data-half></span></span>
                <span class="half bottom fold"><span data-half></span></span>
              </span>
            ))}
          </div>
          <span class="text-[11px] uppercase tracking-[0.12em] text-faint">{label}</span>
        </div>
      ))}
    </div>
    <p class="mt-2 max-w-[520px] text-balance text-base leading-relaxed text-muted">WoW Forever launches on 4 November. Until then, help test the addon and the app on the beta.</p>
  </div>
  <div data-after-launch data-reveal hidden={!launched} class="contents">
    <h2 class="text-3xl font-medium leading-[1.1] tracking-[-0.03em] md:text-[40px]">Start recording your journey.</h2>
    <p class="max-w-[520px] text-balance text-base leading-relaxed text-muted">Install the app before you log in: it puts the addon in for you and keeps every step safe on every PC you play.</p>
  </div>
  <div class="mt-2.5 flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
    <DownloadButton />
    <a href={addonUrl()} class="inline-flex h-11 items-center justify-center rounded-[10px] border border-outline bg-panel px-[18px] text-[15px] font-medium text-text">Get the addon</a>
  </div>
</section>
<script>
  import { wireCountdown } from "../countdown";
  wireCountdown();
</script>
