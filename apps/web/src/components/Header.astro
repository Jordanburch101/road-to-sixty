---
import compass from "@road-to-sixty/ui/compass.png";
import DownloadButton from "./DownloadButton.astro";
---
<header data-reveal class="relative z-10 flex h-16 items-center gap-2.5 border-b border-line-soft px-4 md:px-16">
  <a href="/" class="flex flex-1 items-center gap-2.5 text-base font-semibold text-text">
    <img src={compass.src} alt="" width="28" height="28" class="size-7 rounded-md" />
    Road to Sixty
  </a>
  <nav aria-label="Site" class="hidden items-center md:flex">
    <a href="/#one-road" class="px-3 py-2 text-sm text-muted hover:text-text">How it works</a>
    <a href="/privacy" class="px-3 py-2 text-sm text-muted hover:text-text">Privacy</a>
    <a href="/terms" class="px-3 py-2 text-sm text-muted hover:text-text">Terms</a>
  </nav>
  <DownloadButton size="small" />
</header>
