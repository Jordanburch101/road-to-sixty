{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Road to Sixty",
  "version": "0.1.2",
  "identifier": "online.roadtosixty.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Road to Sixty",
        "width": 400,
        "height": 640,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "backgroundColor": "#07060a",
        "decorations": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFMTg1MzFBNzhEN0I2QTcKUldTbnR0ZDRHbE1ZM2pjaWdBK3U5eTNkWGpnMUdhNytjTlZyZW15Q015S3ZieW9vbG9qWkc1QncK",
      "endpoints": [
        "https://dl.rts.everhold.online/app/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
